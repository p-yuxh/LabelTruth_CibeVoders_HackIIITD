# Google Gemini Vision API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Tavily Search API Configuration (for manufacturer lookup)
TAVILY_API_KEY=your_tavily_api_key_here

# Candidate Match Scoring Thresholds
CONFIDENT_THRESHOLD=0.85
AMBIGUOUS_THRESHOLD=0.60

# Cache Database Connection (SQLite via SQLAlchemy)
DATABASE_URL=sqlite+aiosqlite:///./cache.db

# Provider selection (options: paddleocr | mock; gemini | mock)
OCR_PROVIDER=paddleocr
VISION_PROVIDER=gemini

# Image limits
MAX_IMAGE_SIZE_BYTES=8388608
MAX_IMAGE_SIDE_PX=2000

# App Server
HOST=0.0.0.0
PORT=8000

