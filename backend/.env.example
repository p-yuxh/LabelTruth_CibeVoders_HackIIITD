# LabelTruth Phase 1 Environment Configuration

# Database: PostgreSQL (with automatic SQLite fallback for dev)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/labeltruth
FALLBACK_DATABASE_URL=sqlite+aiosqlite:///./evidence_log.db

# TinyFish API Key
TINYFISH_API_KEY=your_tinyfish_api_key_here
